<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>แบบฟอร์มตรวจสอบคุณภาพ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Sarabun', sans-serif;
            padding: 30px;
            background-color: #f7f7f7;
        }

        /* ใช้เมื่อคุณอยากให้ข้อความบางส่วนเป็น ExtraLight */
        .sarabun-extralight {
            font-weight: 200;
        }

        form {
            background: white;
            padding: 20px;
            border-radius: 10px;
            max-width: 900px;
            margin: auto;
        }

        label {
            display: inline-block;
            width: 150px;
            font-weight: bold;
            /* font-size: 0.9rem; */
        }

        input,
        select,
        textarea {
            margin-bottom: 10px;
            padding: 5px;
            width: 75%;
        }

        .item-block {
            /* border-radius: 0; */
        }

        fieldset {
            border: 1px solid #ccc;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 8px;
        }

        .submit {
            width: 160px;
 height: 40px;
 background: #007bff;  /* เปลี่ยนสีพื้นหลังเมื่อ hover */
 color: #fff;
 border-radius: 10px;
 padding: 10px 15px;
 /* font-family: 'Lato', sans-serif; */
 /* font-weight: 500; */
 /* background: transparent; */
 cursor: pointer;
 transition: all 0.3s ease;
 position: relative;
 /* display: inline-block; */
 box-shadow: inset 2px 2px 2px 0px rgba(255,255,255,.5),
   7px 7px 20px 0px rgba(0,0,0,.1),
   4px 4px 5px 0px rgba(0,0,0,.1);
 outline: none;
}
        button {
            margin-top: -10px;
            padding: 10px 15px;
            background: #ccc;
            color: #444444;
            border: none;
            border-radius: 6px;
            margin-right: 10px;
            cursor: pointer;
          
        }

        /* .label-status {
            display: inline-block;
            width: 50px;
            /* margin-left: 25px; */
        /* margin-right: 5px;
        } */

        .select {
            display: inline-block;
            width: 13%;
        }

        .select.passed {
            background-color: #d4edda;
            /* เขียวอ่อน */
        }

        .date {
            width: 13%;
        }

        .select.failed {
            background-color: #f8d7da;
            /* แดงอ่อน */
        }

        .failed {
            background-color: none;
            /* แดงอ่อน */
        }

        .round {
            width: 13%;
        }

        .bt-add {
            /* right: 0; */
            /* float: right; */
            background-color: #dddddd;
            border: 1px solid #999;
            align-items: center;
        }

        /* .bt-remove{
        width: 20px !important;
        height: 20px !important;
        background-color: none;
        border: none;
    } */
        .input-img {
            padding: 0;
        }

        .submit {
            /* display: flex; */
            /* justify-content: center; */
        }

        /* กรอบคงที่ 600×450 – ปรับได้ตามต้องการ */
        #wrap {
  display: none;
  position: relative;
  width: 100%;
  max-width: 600px;
  aspect-ratio: 4 / 3; /* คงสัดส่วน 600:450 = 4:3 */
  margin: 20px auto; /* จัดกึ่งกลาง */
}


        #wrap img {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
            /* ซ่อนจนกว่าจะเลือกชั้น */
            pointer-events: auto;
            /* ← เปิดให้รับคลิก (ค่าปกติ) */
        }

        #wrap canvas {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            /* ← คลิกทะลุได้ */
        }
        .section-blue {
    background-color: #e0f0ff; /* สีฟ้าอ่อน */
}

    </style>
</head>

<body>
    <h2 style="text-align:center;">แบบฟอร์มตรวจสอบคุณภาพ</h2>

    <form action="/" method="POST" enctype="multipart/form-data">

        <!-- --- SECTION : แบบบ้าน --- -->
        <fieldset class="section-blue" style="margin-bottom:1rem; padding:1rem; border:1px solid #ccc;">
            <legend>ข้อมูลแบบบ้าน</legend>
            <div class="" style="display: flex;">
            <label for="houseType">แบบบ้าน:<span style="color: red;">*</span></label>
            <select id="houseType" name="houseType" required>
                <option value="" disabled selected>-- เลือกแบบบ้าน --</option>
                <option value="ศุภลักษณ์">ศุภลักษณ์</option>
                <option value="ศุภจิตรา">ศุภจิตรา</option>
                <!-- <option value="ศุภทวี">ศุภทวี</option>
                <option value="ศุภสวัสดิ์">ศุภสวัสดิ์</option> -->
                <!-- เพิ่มตามต้องการ -->
            </select>
          </div>
            <!-- Select ชั้น -->
            <!-- เลือกชั้น -->
            <div class="" style="display: flex;">
            <label for="floor">ชั้นที่:<span style="color: red;">*</span></label>
            <select id="floor" name="floor" required>
                <option value="" disabled selected>-- เลือกชั้น --</option>
                <option value="1">1</option>
                <option value="2">2</option>
            </select>
</div>
            <!-- ⬇⬇ ห่อ img + canvas ใน div.wrap ⬇⬇ -->
            <div id="wrap">
                <img id="floorImage" alt="Floor plan">
                <canvas id="canvas"></canvas>
            </div>


        </fieldset>

        <!-- --- SECTION : โครงการ/แปลง/รอบตรวจ --- -->
        <!-- --- SECTION : โครงการ/แปลง/รอบตรวจ + รายการย่อย (ในกรอบเดียว) --- -->
        <fieldset class="section-blue" style="margin-bottom:1rem; padding:1rem; border:1px solid #ccc;">
            <legend>รายละเอียดการตรวจ</legend>

            <!-- --- ข้อมูลโครงการ --- -->
            <div class="" style="display: flex;">
                <label for="project">โครงการ:<span style="color: red;">*</span></label>
                <select id="project" name="project" required>
                    <option value="" disabled selected>เลือกโครงการ</option>
                    <option value="ศุภาลัย ไพรด์">ศุภาลัย ไพรด์</option>
                    <option value="อนุสาวรีย์-ป่าคลอก">อนุสาวรีย์-ป่าคลอก</option>
                    <option value="other">อื่น ๆ (ระบุ)</option>
                </select>
            </div>
            <!-- ฟิลด์กรอกข้อมูลกรณีเลือก "อื่น ๆ" -->
            <div class="" style="display: flex;">
                <label for="otherProject" id="otherProjectLabel" style="display:none;">กรุณาระบุโครงการ: <span
                        style="color: red;">*</span></label>
                <input id="otherProject" type="text" name="otherProject" style="display:none;width: 75%;"
                    placeholder="กรุณาระบุโครงการ"  >
            </div>

            <div class="" style="display: flex;">
                <label for="parcel">แปลงเลขที่:<span style="color: red;">*</span></label>
                <input id="parcel" type="text" name="parcel" required>
            </div>

            <!-- <label for="round">ตรวจครั้งที่:</label>
            <input id="round" class="round" type="number" name="round" min="1" step="1" required><br> -->

            <!-- <label for="round">ตรวจครั้งที่:</label>
            <input id="round" class="round" type="number" name="round" min="1" step="1" required><br> -->

            <div class="" style="display: flex;">
                <label for="date">วันที่ตรวจ (รอบแรก):<span style="color: red;">*</span></label>
                <input id="date" class="date" type="date" name="date" required>
            </div>

            <div class="" style="display: flex;">
                <label for="customer">ลูกค้า:<span style="color: red;">*</span></label>
                <input id="customer" type="text" name="customer" required>
            </div>

            <div class="" style="display: flex;">
                <label for="inspector">ตรวจสอบโดย:<span style="color: red;">*</span></label>
                <input id="inspector" type="text" name="inspector" required>
            </div><br>

            <!-- --- รายการตรวจย่อย (อยู่ใน fieldset เดียวกัน) --- -->
            <div id="item-container">

                <!-- JS จะเพิ่ม fieldset .item-block เข้ามาที่นี่ -->
            </div>
            <div class="sub" style="display: flex; justify-content: center;">
                <button class="bt-add" type="button" style="display: inline-flex;" onclick="addItem()"><img src="/static/add.png" width="15px" height="15px" alt="" style="margin-right: 5px;"> รายการ</button>
            </div>
            <!-- <br><br> -->
        </fieldset>


        <!-- --- SECTION : รายการตรวจย่อย --- -->
        <div id="item-container">
            <!-- จะมีรายการฟอร์มอันแรกมาให้ -->
        </div>
        <!-- <button type="button" onclick="addItem()">เพิ่มรายการ</button>
       -->
        <br>
        <input type="hidden" id="mergedImage" name="canvasImage">

        <div class="sub" style="display: flex; justify-content: center;">
            <button class="submit" type="submit">บันทึกและสร้าง PDF</button>
        </div>
    </form>


    <script>
        let itemCount = 0; // เริ่มนับจาก 0

        function addItem(showDelete = true) {
            // นับจำนวนรายการปัจจุบันจาก DOM
            const container = document.getElementById("item-container");
            const existingItems = container.querySelectorAll(".item-block");
            const currentIndex = existingItems.length + 1;

            const div = document.createElement("fieldset");   // เปลี่ยนเป็น fieldset
            div.className = "item-block";
            div.setAttribute("style", "background-color: white; ");
            div.innerHTML = `
${showDelete
                    ? ` <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
      
    viewBox="0 0 16 16" fill="currentColor"
       style="cursor:pointer;vertical-align:middle;float:right;color:#9d9d9d;"
       onclick="removeItem(this.closest('fieldset'))">
    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>`
                    : ''
                }
      <br/>
 <label for="item_no_${itemCount}">รายการที่: <span class="item-number" style="font-weight: 300;"
 value="${itemCount}">${currentIndex}</span></label><br/><br/>
  <div class="" style="display: flex;"> 
 <label class="label-status">สถานะ:<span style="color: red;">*</span> </label>
  <select class="select status-select" name="status_${currentIndex}" required>
   <option value="" disabled selected>-- สถานะ --</option>
    <option value="ผ่าน">ผ่าน</option>
    <option value="ไม่ผ่าน">ไม่ผ่าน</option>
  </select></div>
 <div class="" style="display: flex;">
  <label>แนบรูป: </label>
  <input class="input-img" type="file" name="image_${currentIndex}" accept="image/*"></div>

 <div class="" style="display: flex;">
  <label>หัวข้อ: </label>
  <input type="text" name="title_${currentIndex}"></div>

 <div class="" style="display: flex;">
  <label>งาน: </label>
  <input type="text" name="work_${currentIndex}"></div>

 <div class="" style="display: flex;">
  <label>รายการ: </label>
  <input type="text" name="item_${currentIndex}">
  </div>

 <div class="" style="display: flex;">
  <label>หมายเหตุ: </label>
  <textarea name="note_${currentIndex}" rows="2"
            style="display:inline-block;width:75%;vertical-align:top;"></textarea></div>


  
`;
            container.appendChild(div);

            updateItemNumbers();
            updateFormData(); // รีเฟรชข้อมูลฟอร์ม
            // ตรวจจับ select เปลี่ยนสี
            const select = div.querySelector('.status-select');

            function updateStatusColor(sel) {
                sel.classList.remove('passed', 'failed');
                if (sel.value === 'ผ่าน') sel.classList.add('passed');
                else if (sel.value === 'ไม่ผ่าน') sel.classList.add('failed');
            }

            select.addEventListener('change', () => updateStatusColor(select));
            updateStatusColor(select);   // เรียกครั้งแรกให้เริ่ม “ไม่มีสี”
            div.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        // ตรวจสอบเมื่อมีการเปลี่ยนแปลงเลือกใน select
        document.getElementById('project').addEventListener('change', function () {
        const projectSelect = document.getElementById('project');
        const otherInput = document.getElementById('otherProject'); // ต้องกำหนดก่อนใช้
        const otherLabel = document.getElementById('otherProjectLabel');
        const otherOption = 'other';

        if (projectSelect.value === otherOption) {
            otherInput.style.display = 'block';
            otherLabel.style.display = 'block';
            otherInput.required = true; // ตั้งให้ required เมื่อเลือก "อื่น ๆ"
        } else {
            otherInput.style.display = 'none';
            otherLabel.style.display = 'none';
            otherInput.required = false; // ไม่ required ถ้าไม่ได้เลือก "อื่น ๆ"
            otherInput.value = ''; // เคลียร์ค่าที่กรอกไว้ (optional)
        }
    });

        function removeItem(button) {
            const itemBlock = button.closest('.item-block');
            if (itemBlock) {
                itemBlock.remove();
            }
            updateItemNumbers();  // อัปเดตหมายเลขรายการ
            updateFormData(); // รีเฟรชข้อมูลฟอร์ม
        }
        function getCanvasImage() {
            const canvas = document.getElementById('canvas');
            const dataURL = canvas.toDataURL('image/png'); // แปลงแคนวาสเป็น Base64 PNG
            return dataURL;
        }

        function updateFormData() {
    const form = document.querySelector('form');
    const formData = new FormData(form);

    // เพิ่มข้อมูลแคนวาส (Base64) ไปใน FormData
    formData.append('canvasImage', getCanvasImage());

    // ตรวจสอบว่าผู้ใช้เลือก "อื่น ๆ" หรือไม่
    const projectValue = document.getElementById('project').value;  // ดึงค่า value ของ select

    if (projectValue === 'other') { // ใช้ 'other' เป็นค่าที่เลือก
        // ถ้าผู้ใช้เลือก "อื่น ๆ" และกรอกข้อมูลในช่อง "อื่น ๆ"
        const otherProjectValue = document.getElementById('otherProject').value;
        if (otherProjectValue) {
            formData.append('otherProject', otherProjectValue); // ส่งข้อมูลจากช่องนี้
        }
    } else {
        const otherProjectValue = document.getElementById('project');
        formData.append('project', projectValue); 
    }

    // ตรวจสอบค่า formData ที่ถูกส่งไป
    console.log('Updated Form Data:', Array.from(formData.entries()));
}


        function updateItemNumbers() {
            const items = document.querySelectorAll('.item-block');
            console.log('Number of items:', items.length);

            items.forEach((item, index) => {
                const currentIndex = index + 1;                       // ลำดับใหม่ 1‑based
                item.querySelector('.item-number').textContent = currentIndex;

                // --- รีเซ็ต name ของทุกฟิลด์ในบล็อกนี้ ---
                item.querySelectorAll('[name]').forEach(el => {
                    const base = el.name.split('_')[0];        // 'status' | 'title' | ...
                    el.name = `${base}_${currentIndex}`;                // กำหนดชื่อใหม่ไม่ซ้ำ
                });
            });
        }



        document.addEventListener('DOMContentLoaded', () => {
            const img = document.getElementById('floorImage');
            const canvas = document.getElementById('canvas');
            const ctx = canvas.getContext('2d');

            /* --- ขนาด canvas คงที่ตรงกรอบ --- */
            canvas.width = 600;
            canvas.height = 450;
            /* ---------- รวมภาพก่อน submit ---------- */
            document.querySelector('form').addEventListener('submit', async () => {
                // รอภาพแปลนพร้อม
                if (!img.complete) await img.decode();

                const merge = document.createElement('canvas');
                merge.width = canvas.width;
                merge.height = canvas.height;
                const mctx = merge.getContext('2d');

                mctx.drawImage(img, 0, 0, merge.width, merge.height);  // แปลน
                mctx.drawImage(canvas, 0, 0);                          // หมุด

                document.getElementById('mergedImage').value =
                    merge.toDataURL('image/png');
            });


            const floorSelect = document.getElementById('floor');
  const wrap = document.getElementById('wrap');

  floorSelect.addEventListener('change', () => {
    if (floorSelect.value !== "") {
      wrap.style.display = 'block';
    } else {
      wrap.style.display = 'none';
    }
  });
            /* ---- ไอคอนหมุด ---- */
            const pin = new Image();
            pin.src = '/static/oval.png';
            let pinReady = false;
            pin.onload = () => pinReady = true;

            /* เก็บตำแหน่งหมุดทั้งหมด */
            const pins = [];                       // [{x,y}, …]

            /* ฟังก์ชันรีเฟรชการวาดหมุด */
            function redraw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (const p of pins) {
                    ctx.drawImage(pin, p.x - 23, p.y - 12, 50, 30); // 35×35, +6 offset
                }
            }

            /* ฟังก์ชันตรวจสอบว่ามีหมุดอยู่ที่ (x, y) หรือไม่ */
            function pinAt(x, y, radius = 20) {
                return pins.findIndex(p => Math.hypot(p.x - x, p.y - y) < radius);
            }

            /* แผนที่ตามแบบบ้านและชั้น */
            const planMap = {
                'ศุภลักษณ์': {
                    1: '/static/plans/ศุภลักษณ์/f1.png',
                    2: '/static/plans/ศุภลักษณ์/f2.png'
                },
                'ศุภจิตรา': {
                    1: '/static/plans/ศุภจิตรา/f1.jpg',
                    2: '/static/plans/ศุภจิตรา/f2.jpg'
                }
                // เพิ่มแบบอื่นๆ ตามต้องการ
            };

            /* ฟังก์ชันเปลี่ยนรูปตามแบบบ้านและชั้น */
            function updatePlan() {
                const house = document.getElementById('houseType').value; // รับค่าจากแบบบ้าน
                const floor = document.getElementById('floor').value; // รับค่าจากชั้นที่เลือก
                const src = planMap[house]?.[floor]; // ดึง path รูปจาก planMap

                if (src) {
                    img.src = src; // ตั้งค่าภาพแผนที่
                    img.style.display = 'block'; // แสดงแผนที่
                    ctx.clearRect(0, 0, canvas.width, canvas.height); // ลบหมุดทั้งหมด
                    pins.length = 0; // รีเซ็ตตำแหน่งหมุด
                } else {
                    img.style.display = 'none'; // ซ่อนแผนที่ถ้าไม่มีข้อมูล
                    ctx.clearRect(0, 0, canvas.width, canvas.height); // ลบหมุดทั้งหมด
                    pins.length = 0; // รีเซ็ตหมุด
                }
            }

            /* ฟังเหตุการณ์ทั้งสอง select */
            document.getElementById('houseType').addEventListener('change', updatePlan);
            document.getElementById('floor').addEventListener('change', updatePlan);


            /* ---------- คลิกวางหมุด ---------- */
            /* เมื่อคลิก จะเพิ่มหรือลบหมุด */
            img.addEventListener('click', ev => {
                if (!pinReady) return;

                const rect = img.getBoundingClientRect();   // ขนาด 600×450
                const x = ev.clientX - rect.left;
                const y = ev.clientY - rect.top;

                const idx = pinAt(x, y);          // ถ้าคลิกบนหมุดที่มีอยู่แล้ว?
                if (idx !== -1) {
                    /* ลบหมุดที่คลิก */
                    pins.splice(idx, 1);
                } else {
                    /* เพิ่มหมุดใหม่ */
                    pins.push({ x, y });
                }
                redraw();                         // อัพเดท canvas
            });

            /* เมื่อเปลี่ยนชั้น -> ลบหมุดทั้งหมด */
            document.getElementById('floor').addEventListener('change', () => {
                pins.length = 0;                  // รีเซ็ต array
                redraw();                         // ลบหมุดทั้งหมด
            });
        });



        // เรียกแค่รายการแรกแบบไม่มีปุ่มลบ
        window.onload = () => addItem(false);
    </script>


</body>

</html>